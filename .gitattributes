# ==============================================================================
# Git Attributes - Line Ending Normalization
# ==============================================================================
# Enforce LF endings across all operating systems to prevent rustfmt failures

* text=auto eol=lf

*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# ==============================================================================
# MTG Collection Manager - .gitignore
# ==============================================================================

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Node.js & Web Frontend ---
node_modules/
dist/
dist-ssr/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Rust & Cargo ---
target/
src-tauri/target/
crates/**/target/
**/*.rs.bk

# --- Tauri & Desktop Packaging ---
src-tauri/gen/
*.exe
*.msi
*.deb
*.rpm
*.AppImage
*.dmg
*.zip
*.tar.gz

# Note: keep .gitkeep files in binaries if needed
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# --- Database & Storage (SQLite) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
collection.db*
scryfall_cache.db*

# --- AI Models & Weights (Downloaded On-Demand by User) ---
models/
**/*.gguf
**/*.bin
**/*.safetensors
**/*.onnx
*.part

# --- Scans, Temporary Images & Crops (Privacy & Size) ---
scans/
crops/
temp/
debug/
captures/
Ritagli/
Scansioni/
scansioni/
*.tmp
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.webp
*.pnm
*.pbm
*.ppm
*.raw
*.dng
*.cr2
*.nef
*.arw
debug_capture.png
*.log

# Explicit exceptions for approved project documentation assets
!docs/assets/**
!assets/**

# --- Secrets, Credentials & Certificates ---
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem
*.cert
credentials.json
token.json
